{
  "name": "FartWars",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Remotes": {
        "$className": "Folder",
        "RequestPlay": {
          "$className": "RemoteEvent"
        },
        "RequestTeam": {
          "$className": "RemoteEvent"
        },
        "RequestSpectate": {
          "$className": "RemoteEvent"
        },
        "RoundSnapshot": {
          "$className": "RemoteFunction"
        },
        "RoundUpdate": {
          "$className": "RemoteEvent"
        },
        "TeamUpdate": {
          "$className": "RemoteEvent"
        },
        "UIMessage": {
          "$className": "RemoteEvent"
        },
        "FireWeapon": {
          "$className": "RemoteEvent"
        },
        "FartDash": {
          "$className": "RemoteEvent"
        },
        "CombatEvent": {
          "$className": "RemoteEvent"
        },
        "ProgressEvent": {
          "$className": "RemoteEvent"
        },
        "UseAbility": {
          "$className": "RemoteEvent"
        },
        "ShopRequest": {
          "$className": "RemoteFunction"
        },
        "ProfileUpdate": {
          "$className": "RemoteEvent"
        },
        "RewardsRequest": {
          "$className": "RemoteFunction"
        },
        "Emote": {
          "$className": "RemoteEvent"
        },
        "ReportPlayer": {
          "$className": "RemoteFunction"
        },
        "ClientReport": {
          "$className": "RemoteEvent"
        },
        "PrestigeRequest": {
          "$className": "RemoteFunction"
        }
      },
      "Assets": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "Weapons": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Props": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        }
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "ServerStorage": {
      "Maps": {
        "$path": "src/maps"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "EnableMouseLockOption": false,
        "CameraMinZoomDistance": 6,
        "CameraMaxZoomDistance": 24,
        "CharacterWalkSpeed": 16
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false,
        "RespawnTime": 3
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": false
      }
    }
  }
}
