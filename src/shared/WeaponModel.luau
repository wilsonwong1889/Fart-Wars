-- The weapons' models, from the Blender art (Config/WeaponArt, generated by
-- art/blender/build_weapons.py). The model is made of, in order of
-- preference:
--   * "mesh": the meshes imported into ReplicatedStorage.Assets.Weapons.
--     <Weapon> (one MeshPart per role and moving part, from
--     art/export/weapons/<Weapon>.fbx), if they're there and the right way
--     round;
--   * "runtime": the same meshes built in the game (MeshBuilder, from
--     Shared.MeshData), on a client that has built them; nothing to import;
--   * "pieces": a stand-in built from the same blocks, cylinders and balls
--     the meshes were modelled from.
-- Either way each part is placed, sized and coloured from WeaponArt, so an
-- import's position or scale doesn't matter. The grip is at the origin,
-- the barrel along -Z, the top +Y. Each part says which mesh it is
-- (attribute Mesh) and which role (Role); the parts that move (the pump,
-- the gauge's needle, the Stink Lobber's bomb) say which (Part) and, in a
-- held gun, hang on a Weld named Move that the clients animate.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WeaponArt = require(script.Parent.Config.WeaponArt)
local ShotArt = require(script.Parent.Config.ShotArt)
local MeshBuilder = require(script.Parent.MeshBuilder)

local WeaponModel = {}

-- How far an imported mesh's proportions may be from the Blender model's
-- before it counts as imported the wrong way round.
WeaponModel.TOLERANCE = 0.2

local SHAPES = {
	block = Enum.PartType.Block,
	cylinder = Enum.PartType.Cylinder,
	ball = Enum.PartType.Ball,
}

local function folder(): Instance?
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	if not assets then
		return nil
	end
	return assets:FindFirstChild("Weapons") or assets
end

-- Whether `meshSize` (an imported mesh's own size) has the proportions of
-- `size` (the Blender model's), so it isn't lying on its side.
function WeaponModel.matches(meshSize: Vector3, size: Vector3): boolean
	local axes = { "X", "Y", "Z" }
	for i = 1, 3 do
		for j = i + 1, 3 do
			local a, b = axes[i], axes[j]
			local want = (size :: any)[a] / math.max((size :: any)[b], 1e-3)
			local got = (meshSize :: any)[a] / math.max((meshSize :: any)[b], 1e-3)
			if math.abs(got / math.max(want, 1e-3) - 1) > WeaponModel.TOLERANCE then
				return false
			end
		end
	end
	return true
end

-- A shot effect's imported mesh (Config/ShotArt: MuzzleBurst, GasBolt,
-- Splat) from ReplicatedStorage.Assets.Effects, a MeshPart named after it
-- or the Model the importer made with one inside; or nil and why not.
function WeaponModel.effect(name: string): (MeshPart?, string)
	local art = ShotArt[name]
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local effects = assets and assets:FindFirstChild("Effects")
	local found = effects and effects:FindFirstChild(name)
	if found and not found:IsA("MeshPart") then
		found = found:FindFirstChildWhichIsA("MeshPart", true)
		if not found then
			return nil, `no MeshPart in {name}`
		end
	end
	if not (art and found) then
		return nil, "not imported"
	end
	local meshSize = (found :: any).MeshSize
	if typeof(meshSize) == "Vector3" and meshSize.Magnitude > 0 and not WeaponModel.matches(meshSize, art.size) then
		return nil, `{name} is the wrong way round (re-import with Forward -Z, Up +Y)`
	end
	return found :: MeshPart, "imported"
end

-- The imported MeshParts for `weaponId` by mesh name, or nil and why not.
function WeaponModel.imported(weaponId: string): ({ [string]: MeshPart }?, string)
	local art = WeaponArt[weaponId]
	local root = folder()
	local model = root and root:FindFirstChild(weaponId)
	if not (art and model) then
		return nil, "not imported"
	end
	local found = {}
	for name, mesh in art.meshes do
		local part = model:FindFirstChild(name, true)
		if not (part and part:IsA("MeshPart")) then
			return nil, `no {name} MeshPart`
		end
		local meshSize = (part :: any).MeshSize
		if typeof(meshSize) == "Vector3" and meshSize.Magnitude > 0 and not WeaponModel.matches(meshSize, mesh.size) then
			return nil, `{name} is the wrong way round (re-import with Forward -Z, Up +Y)`
		end
		found[name] = part :: MeshPart
	end
	return found, "imported"
end

local function style(part: BasePart, role: WeaponArt.Role, anchored: boolean)
	part.Color = role.color
	part.Material = role.material
	part.Transparency = role.transparency
	part.Anchored = anchored
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CastShadow = false
end

-- The weapon's parts, placed from `origin` (the grip), and where they came
-- from: "mesh" (imported), "runtime" (built in the game: only when
-- `runtime` is asked for and this client has built them; see the top) or
-- "pieces" (the stand-in).
function WeaponModel.parts(weaponId: string, origin: CFrame, anchored: boolean?, runtime: boolean?): ({ BasePart }, string)
	local art = assert(WeaponArt[weaponId], `no art for {weaponId}`)
	local parts = {}
	local function finish(part: BasePart, name: string, role: string, moving: string?)
		style(part, art.roles[role], anchored == true)
		part:SetAttribute("Mesh", name)
		part:SetAttribute("Role", role)
		if moving then
			part:SetAttribute("Part", moving)
		end
		if role == "Gas" then
			part:SetAttribute("Gas", true)
		end
		table.insert(parts, part)
	end
	local meshes = WeaponModel.imported(weaponId)
	local built = if runtime and not meshes and MeshBuilder.ready(weaponId) then {} else nil
	if built then
		for name in art.meshes do
			local made = MeshBuilder.copy(weaponId, name)
			if not made then
				built = nil
				break
			end
			built[name] = made
		end
	end
	if meshes or built then
		for name, mesh in art.meshes do
			local part = if meshes then meshes[name]:Clone() else (built :: any)[name]
			part.Name = name
			part.Size = mesh.size
			part.CFrame = origin * CFrame.new(mesh.center)
			finish(part, name, mesh.role, if mesh.moving then name else nil)
		end
		return parts, if meshes then "mesh" else "runtime"
	end
	for _, piece in art.pieces do
		if piece.standin ~= false then
			local part = Instance.new("Part")
			part.Name = piece.part or piece.role
			part.Shape = SHAPES[piece.shape] or Enum.PartType.Block
			part.Size = piece.size
			part.CFrame = origin * piece.cframe
			part.TopSurface = Enum.SurfaceType.Smooth
			part.BottomSurface = Enum.SurfaceType.Smooth
			finish(part, piece.part or piece.role, piece.role, piece.part)
		end
	end
	return parts, "pieces"
end

-- Fixes `part` to the gun's `handle` where it is now: a moving part on a
-- Weld named Move (whose C0 the clients animate; Rest keeps where it
-- belongs), the rest on a WeldConstraint.
function WeaponModel.attach(handle: BasePart, part: BasePart)
	if part:GetAttribute("Part") then
		local weld = Instance.new("Weld")
		weld.Name = "Move"
		weld.Part0 = handle
		weld.Part1 = part
		weld.C0 = handle.CFrame:ToObjectSpace(part.CFrame)
		weld:SetAttribute("Part", part:GetAttribute("Part"))
		weld:SetAttribute("Rest", weld.C0)
		weld.Parent = part
	else
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = handle
		weld.Part1 = part
		weld.Parent = handle
	end
end

-- The muzzle, from the grip: an Attachment's CFrame whose +Y (where
-- particles go) points down the barrel.
function WeaponModel.muzzle(weaponId: string): CFrame
	local art = assert(WeaponArt[weaponId])
	return CFrame.new(art.muzzle) * CFrame.Angles(-math.pi / 2, 0, 0)
end

-- The held weapon: a Tool whose invisible Handle is the grip, every part
-- welded to it, and a Muzzle attachment. Nothing in it can be hit, touched
-- or collided with. Built on the server, so never from runtime meshes:
-- each client dresses it in them (WeaponSkin).
function WeaponModel.tool(weaponId: string, displayName: string?): Tool
	local tool = Instance.new("Tool")
	tool.Name = "HeldWeapon"
	tool.ToolTip = displayName or weaponId
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.ManualActivationOnly = true
	tool:SetAttribute("Weapon", weaponId)
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.3, 0.6, 0.3)
	handle.Transparency = 1
	handle.CanCollide = false
	handle.CanQuery = false
	handle.CanTouch = false
	handle.Massless = true
	handle.CastShadow = false
	handle.CFrame = CFrame.new()
	handle.Parent = tool
	local parts, source = WeaponModel.parts(weaponId, CFrame.new())
	for _, part in parts do
		part.Parent = tool
		WeaponModel.attach(handle, part)
	end
	local muzzle = Instance.new("Attachment")
	muzzle.Name = "Muzzle"
	muzzle.CFrame = WeaponModel.muzzle(weaponId)
	muzzle.Parent = handle
	tool:SetAttribute("ArtSource", source)
	return tool
end

-- The weapon as a still model (for screens on a client): anchored parts,
-- the grip at the origin, the runtime meshes once they're built, and its
-- box (center, size) for framing.
function WeaponModel.model(weaponId: string): (Model, Vector3, Vector3)
	local model = Instance.new("Model")
	model.Name = weaponId
	local parts, source = WeaponModel.parts(weaponId, CFrame.new(), true, true)
	local lo, hi = Vector3.one * math.huge, -Vector3.one * math.huge
	for _, part in parts do
		part.Parent = model
		local half = part.Size / 2
		local corners = { part.CFrame.Position - half, part.CFrame.Position + half }
		for _, corner in corners do
			lo = Vector3.new(math.min(lo.X, corner.X), math.min(lo.Y, corner.Y), math.min(lo.Z, corner.Z))
			hi = Vector3.new(math.max(hi.X, corner.X), math.max(hi.Y, corner.Y), math.max(hi.Z, corner.Z))
		end
	end
	model:SetAttribute("ArtSource", source)
	return model, (lo + hi) / 2, hi - lo
end

return WeaponModel
